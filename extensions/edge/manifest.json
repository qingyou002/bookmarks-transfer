{
  "manifest_version": 3,
  "name": "本机浏览器迁移 · Edge",
  "version": "0.1.0",
  "description": "与本机 Python 桌面工具配合进行双向数据迁移。",
  "minimum_chrome_version": "132",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "bookmarks",
    "cookies",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "浏览器迁移",
    "default_popup": "bridge.html"
  }
}